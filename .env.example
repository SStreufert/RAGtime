# Paths
# CHROMA_DIR=./chroma_db
# DATA_DIR=./data

# Model ids must match what the endpoint reports (`lms ls` for LM Studio, `ollama list` for Ollama)
# OpenAI-compatible endpoints (Ollama or LM Studio) — must include /v1
# Local backends ignore the key; the OpenAI client just refuses an empty one.

# Embedding
# EMBEDDINGS_BASE_URL=http://localhost:11434/v1
# EMBEDDINGS_API_KEY=lm-studio
# EMBEDDING_MODEL=nomic-embed-text

# Chunking
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100

# Chat
### CHAT_BASE_URL=http://192.168.1.22:1234/v1
### CHAT_API_KEY=lm-studio
### CHAT_MODEL=ornith-1.5-9b

# Generation
# TEMPERATURE=0.2
# MAX_TOKENS=4096

# Retrieval
# TOP_K=7

# Judge
### JUDGE_BASE_URL=http://192.168.1.20:1234/v1
# JUDGE_TEMPERATURE=0.2
### JUDGE_MODEL=qwen3-8b

# MLflow
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=rag-pipeline
# SCORER_TIMEOUT=0

